{
  "$comment": "Source de public/assets/animations.json — généré par vite/plugins/animations.ts au démarrage de Vite (dev et build).",
  "output": "public/assets/animations.json",
  "frameRate": 10,
  "repeat": -1,
  "sheets": [
    {
      "$comment": "Pack Ninja Adventure : une colonne par direction, une ligne par frame de marche.",
      "keys": ["ninjaGreen-walk", "mushroom-walk", "reptile-walk"],
      "layout": "column",
      "columns": 4,
      "rows": 4,
      "animations": ["down", "up", "left", "right"]
    },
    {
      "$comment": "Attaque : une frame par direction, jouée une fois. Passer rows à N si la feuille gagne des frames.",
      "keys": ["ninjaGreen-attack"],
      "layout": "column",
      "columns": 4,
      "rows": 1,
      "animations": ["down", "up", "left", "right"],
      "repeat": 0
    },
    {
      "$comment": "Entaille : 6 frames jouées une fois, FxStep peut en imposer la durée.",
      "keys": ["slash02", "slashCircular"],
      "layout": "sequence",
      "framesPerAnimation": 6,
      "animations": ["strike"],
      "frameRate": 24,
      "repeat": 0
    },
    {
      "$comment": "Taillade projetée : 6 frames jouées une fois, étirées sur la course du projectile.",
      "keys": ["slashArc"],
      "layout": "sequence",
      "framesPerAnimation": 6,
      "animations": ["fly"],
      "repeat": 0
    },
    {
      "$comment": "Tourbillon : les 4 directions de l'attaque, dans le sens horaire depuis le regard, inversé vers la gauche.",
      "keys": ["ninjaGreen-attack"],
      "prefix": "ninjaGreen-spin",
      "layout": "frames",
      "animations": { "down": [0, 2, 1, 3], "up": [1, 3, 0, 2], "left": [2, 0, 3, 1], "right": [3, 0, 2, 1] },
      "frameRate": 20,
      "repeat": 0
    },
    {
      "$comment": "Charge du champignon, de face, alternée vite.",
      "keys": ["mushroom-walk"],
      "prefix": "mushroom",
      "layout": "frames",
      "animations": { "charge": [4, 8] },
      "frameRate": 20
    },
    {
      "$comment": "Lâcher du champignon, de face, chapeau écrasé.",
      "keys": ["mushroom-walk"],
      "prefix": "mushroom",
      "layout": "frames",
      "animations": { "release": [12] },
      "repeat": 0
    },
    {
      "$comment": "Bouffée de fumée : 6 frames jouées une fois, FxStep peut en imposer la durée.",
      "keys": ["smoke"],
      "layout": "sequence",
      "framesPerAnimation": 6,
      "animations": ["puff"],
      "frameRate": 12,
      "repeat": 0
    },
    {
      "$comment": "Éclats de roche du reptile, à partir de l'impact.",
      "keys": ["rockBurst"],
      "layout": "frames",
      "animations": { "burst": [7, 8, 9, 10, 11, 12, 13] },
      "frameRate": 14,
      "repeat": 0
    },
    {
      "$comment": "Anneau de poussière au sol, 8 frames jouées une fois.",
      "keys": ["smokeCircular"],
      "layout": "sequence",
      "framesPerAnimation": 8,
      "animations": ["puff"],
      "frameRate": 14,
      "repeat": 0
    }
  ]
}
